# Enter the flake's dev shell on cd. `use flake` already watch_file's flake.nix and
# flake.lock, so edits to either trigger a reload.
#
# Editors and agents start direnv from a non-login shell, where a single-user Nix install
# is not yet on PATH; without this the failure is a bare "nix: command not found".
if ! command -v nix >/dev/null 2>&1 && [ -e /etc/profile.d/nix.sh ]; then
  . /etc/profile.d/nix.sh
fi

use flake
